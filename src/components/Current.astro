---
import { siteConfig } from "../config";
const current = siteConfig.current;
---
<section id="current" class="p-8 sm:p-12 md:p-16 lg:p-24 bg-gray-50">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="text-sm uppercase tracking-wider text-gray-600">{current.status}</p>
      <h2 class="mt-4 text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900">{current.name}</h2>
    </div>
    <div class="lg:col-span-8 space-y-6">
      <p class="text-xl sm:text-2xl leading-relaxed text-gray-900">{current.summary}</p>
      <p class="text-lg leading-relaxed text-gray-600">{current.context}</p>
      <p class="text-lg leading-relaxed text-gray-600">{current.role}</p>
      <a href={`${import.meta.env.BASE_URL}/ledgr/`} class="inline-block font-semibold underline underline-offset-4 text-gray-900">Read the case study →</a>
    </div>
  </div>
</section>

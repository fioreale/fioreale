---
import { siteConfig } from "../config";
import "../styles/global.css";
const current = siteConfig.current;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={current.summary} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{current.name} — {siteConfig.name}</title>
  </head>
  <body>
    <main class="mx-auto max-w-5xl px-8 sm:px-12 py-16 sm:py-24">
      <a href={`${import.meta.env.BASE_URL}/#current`} class="text-gray-700 underline underline-offset-4">← Back to portfolio</a>
      <p class="mt-16 text-sm uppercase tracking-wider text-gray-600">{current.status} · Product case study</p>
      <h1 class="mt-4 text-4xl sm:text-6xl font-bold text-gray-900">{current.name}</h1>
      <p class="mt-8 text-xl sm:text-2xl leading-relaxed text-gray-800">{current.summary}</p>
      <p class="mt-6 text-lg leading-relaxed text-gray-600">{current.context}</p>
      <p class="mt-6 text-lg leading-relaxed text-gray-600">{current.role}</p>
      <div class="mt-16 space-y-12">
        {current.caseStudy.map((section) => (
          <section class="border-t border-gray-200 pt-8">
            <h2 class="text-2xl font-semibold text-gray-900">{section.title}</h2>
            <p class="mt-4 text-lg leading-relaxed text-gray-600">{section.text}</p>
          </section>
        ))}
      </div>
      <a href={`${import.meta.env.BASE_URL}/#work-with-me`} class="mt-16 inline-block font-semibold underline underline-offset-4 text-gray-900">Discuss a similar workflow →</a>
    </main>
  </body>
</html>
